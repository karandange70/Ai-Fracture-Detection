# ==============================================================================
# BoneSense AI - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust variables as needed for your deployment.

# Server & Network Configuration
FLASK_APP=src/app.py
FLASK_ENV=development
HOST=127.0.0.1
PORT=5000

# Compute Device (options: 'cpu', 'cuda', 'cuda:0')
BONESENSE_DEVICE=cpu

# Optional Custom Cache Directory for Matplotlib
MPLCONFIGDIR=.cache/matplotlib

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

