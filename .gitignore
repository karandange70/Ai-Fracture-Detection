# ==============================================================================
# BoneSense AI - Git Ignore Specification
# ==============================================================================

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
env.bak/
venv.bak/

# Environment files
.env
!.env.example

# IDE & Editor settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.project
.pydevproject
.settings/

# Operating system files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# Temporary directories and cache
.cache/
.matplotlib/
scratch/
tmp/
temp/

# Redundant timestamped checkpoint backups & large archives (>100MB)
checkpoints/backups/
chat_history_backup/
*.zip
*.tar.gz
*.rar

# Model checkpoints (>5MB)
# Large weights are hosted via GitHub Releases to prevent HTTP 408 timeouts
checkpoints/*.pt
!checkpoints/anatomy_classifier.pt
experiments/mura_transfer_learning/checkpoints/*.pt

# Bulk image datasets (Preserve directories via .gitkeep)
data/cleaned/*
!data/cleaned/.gitkeep
data/fracatlas_prepared/*
!data/fracatlas_prepared/.gitkeep
data/raw/*
!data/raw/.gitkeep
data/dataset_splits/*
!data/dataset_splits/.gitkeep
data/predictions/*
!data/predictions/.gitkeep
